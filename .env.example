# Server-only settings (apps/server). Copy to .env and fill in real values.
# Never put these in the desktop app or web demo.

ANTHROPIC_API_KEY=your-anthropic-api-key
DATABASE_URL=postgres://user:password@localhost:5432/kworum
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
SENTRY_DSN=your-sentry-dsn
SERVER_PORT=3000
